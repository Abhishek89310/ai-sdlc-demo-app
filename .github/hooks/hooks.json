{
  "version": 1,
  "hooks": {
    "sessionStart": [
      { "type": "command", "bash": "./scripts/hooks/log-event.sh sessionStart", "timeoutSec": 10 }
    ],
    "userPromptSubmitted": [
      { "type": "command", "bash": "./scripts/hooks/log-event.sh userPromptSubmitted", "timeoutSec": 10 }
    ],
    "preToolUse": [
      { "type": "command", "bash": "./scripts/hooks/log-event.sh preToolUse", "timeoutSec": 10 }
    ],
    "postToolUse": [
      { "type": "command", "bash": "./scripts/hooks/log-event.sh postToolUse", "timeoutSec": 10 }
    ],
    "sessionEnd": [
      { "type": "command", "bash": "./scripts/hooks/log-event.sh sessionEnd", "timeoutSec": 10 }
    ]
  }
}
